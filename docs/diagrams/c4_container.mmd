C4Container
title FTGO – Container Diagram (Nivel 2 - Arquitectura objetivo de microservicios)

Person(consumer_c2, "Consumidor", "Usuario final, accede vía móvil/web")
Person(restaurant_c2, "Restaurante", "Negocio, accede vía dashboard web")
Person(courier_c2, "Courier", "Repartidor, accede vía móvil")
Person(backoffice_c2, "Empleado FTGO", "Personal, accede vía dashboard")

System_Boundary(ftgo_platform, "FTGO Platform") {

    Container(mobile_app, "Mobile App", "React Native / Flutter", "Aplicación cliente para consumidores y couriers")

    Container(web_consumer, "Web App (Consumer)", "React / Vue", "Aplicación web para consumidores")

    Container(web_restaurant, "Restaurant Dashboard", "React / Vue", "Dashboard para restaurantes")

    Container(api_gateway, "API Gateway", "Spring Cloud Gateway / Kong", "Punto de entrada único")

    Container(consumer_service, "Consumer Service", "Java 17 / Spring Boot", "Gestión de consumidores")

    Container(restaurant_service, "Restaurant Service", "Java 17 / Spring Boot", "Gestión de restaurantes y menús")

    Container(order_service, "Order Service", "Java 17 / Spring Boot", "Toma y validación de pedidos")

    Container(kitchen_service, "Kitchen Service", "Java 17 / Spring Boot", "Gestión de tickets de cocina")

    Container(delivery_service, "Delivery Service", "Java 17 / Spring Boot", "Asignación y tracking de couriers")

    Container(billing_service, "Billing Service", "Java 17 / Spring Boot", "Procesamiento de pagos")

    Container(notification_service, "Notification Service", "Node.js / Python", "Envío de emails, SMS y notificaciones")

    Container(kafka_broker, "Kafka Broker", "Apache Kafka", "Bus de eventos")

    Container(api_cache, "API Cache", "Redis", "Cache distribuida")

    ContainerDb(consumer_db, "Consumer DB", "PostgreSQL", "Datos de consumidores")

    ContainerDb(restaurant_db, "Restaurant DB", "PostgreSQL", "Datos de restaurantes")

    ContainerDb(order_db, "Order DB", "PostgreSQL", "Datos de pedidos")

    ContainerDb(delivery_db, "Delivery DB", "PostgreSQL", "Datos de entregas")

    ContainerDb(billing_db, "Billing DB", "PostgreSQL", "Datos financieros")

    ContainerDb(event_log, "Event Store", "PostgreSQL", "Auditoría y eventos")
}

System_Boundary(legacy_ftgo, "Monolito Legacy") {

    Container(ftgo_monolith, "FTGO Monolith", "Java WAR", "Sistema legado")

    ContainerDb(monolith_db, "Monolith DB", "MySQL/Oracle", "Base de datos legacy")
}

